<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Voltar"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Gerar Nova SkillTree"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="O que você deseja aprender?"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxBackgroundColor="@color/bg_surface"
                app:boxStrokeColor="@color/cyan_neon"
                app:hintTextColor="@color/cyan_neon"
                android:textColorHint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: Python, Desenvolvimento Android, Banco de Dados..."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick Suggestions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sugestões populares:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAndroid"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desenvolvimento Android"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPython"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Python"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDb"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banco de Dados &amp; SQL"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJava"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java Orientado a Objetos"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnglish"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inglês Técnico"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNetworks"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redes de Computadores"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Level Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Seu nível atual no tema:"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLevelBeginner"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Iniciante (Do zero)"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLevelIntermediate"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intermediário"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLevelAdvanced"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avançado"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Objective Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Qual é o seu objetivo de estudo?"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObjective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxBackgroundColor="@color/bg_surface"
                app:boxStrokeColor="@color/cyan_neon"
                app:hintTextColor="@color/cyan_neon"
                android:textColorHint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObjective"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: Construir um app para a faculdade, passar na entrevista..."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Daily Study Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tempo disponível para estudo:"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTime30"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 min/dia"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTime60"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="1 hora/dia"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTime120"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 horas/dia"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_surface" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateTree"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="GERAR SKILLTREE COM IA"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cyan_neon"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Loading State Overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#E60D1117"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/cyan_neon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gerando Árvore de Aprendizagem..."
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consultando Inteligência Artificial e estruturando grafo de competências..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAlignment="center" />
    </LinearLayout>

</LinearLayout>
